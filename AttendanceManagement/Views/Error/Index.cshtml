<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Page Not Found</title>
    <style>


        .error-container {
            text-align: center;
            max-width: 100%;
            padding: 20px;
        }

        .error-code {
            font-size: calc(4rem + 2vw);
            font-weight: bold;
            color: #ff6b6b;
        }

        .error-message {
            font-size: calc(1.2rem + 0.5vw);
            margin: 10px 0;
        }

        .error-description {
            font-size: calc(0.9rem + 0.3vw);
            margin-bottom: 20px;
            color: #555;
        }

        .home-link {
            display: inline-block;
            padding: 10px 20px;
            font-size: calc(0.9rem + 0.2vw);
            color: #fff;
            background-color: #007bff;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .home-link:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-code">404</div>
        <div class="error-message"></div>
        <div class="error-description">@ViewBag.Message</div>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="home-link">Go Back to Home</a>
    </div>
</body>
</html>
